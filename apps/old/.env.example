# Local only. In the browser, auth uses window.location.origin so production
# never calls a baked-in localhost URL.
VITE_API_URL=http://localhost:3090

# Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-secret
BETTER_AUTH_URL=http://localhost:3090
CORS_ORIGINS=http://localhost:3090
ADMIN_EMAIL=you@example.com

# Database — local SQLite, or Turso (`libsql://…`) in production
DATABASE_URL=file:./data/shift-sync.db

# Required for Turso only (leave empty for local `file:` SQLite)
DATABASE_AUTH_TOKEN=
